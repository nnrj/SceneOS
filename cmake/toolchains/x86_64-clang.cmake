set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(DEFINED ENV{SCENEOS_CLANG} AND NOT "$ENV{SCENEOS_CLANG}" STREQUAL "")
    set(CMAKE_C_COMPILER "$ENV{SCENEOS_CLANG}" CACHE FILEPATH "Clang executable")
else()
    find_program(SCENEOS_CLANG_EXECUTABLE NAMES clang clang.exe REQUIRED)
    set(CMAKE_C_COMPILER "${SCENEOS_CLANG_EXECUTABLE}" CACHE FILEPATH "Clang executable")
endif()

set(CMAKE_C_COMPILER_ID Clang)
set(CMAKE_C_COMPILER_FORCED TRUE)

if(DEFINED ENV{SCENEOS_LLD} AND NOT "$ENV{SCENEOS_LLD}" STREQUAL "")
    set(CMAKE_LINKER "$ENV{SCENEOS_LLD}" CACHE FILEPATH "LLD executable")
else()
    find_program(SCENEOS_LLD_EXECUTABLE NAMES ld.lld ld.lld.exe REQUIRED)
    set(CMAKE_LINKER "${SCENEOS_LLD_EXECUTABLE}" CACHE FILEPATH "LLD executable")
endif()
set(
    CMAKE_C_LINK_EXECUTABLE
    "<CMAKE_LINKER> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>"
)

if(DEFINED ENV{SCENEOS_NASM} AND NOT "$ENV{SCENEOS_NASM}" STREQUAL "")
    set(CMAKE_ASM_NASM_COMPILER "$ENV{SCENEOS_NASM}" CACHE FILEPATH "NASM executable")
else()
    find_program(SCENEOS_NASM_EXECUTABLE NAMES nasm nasm.exe REQUIRED)
    set(CMAKE_ASM_NASM_COMPILER "${SCENEOS_NASM_EXECUTABLE}" CACHE FILEPATH "NASM executable")
endif()

set(CMAKE_ASM_NASM_COMPILER_ID NASM)
set(CMAKE_ASM_NASM_COMPILER_FORCED TRUE)
set(CMAKE_C_COMPILER_TARGET x86_64-unknown-none-elf)
set(CMAKE_ASM_NASM_OBJECT_FORMAT elf64)
